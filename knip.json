{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/main.js",
    "app/workers/search.worker.js",
    "app/workers/ign-catalog.worker.js",
    "sw.js",
    "scripts/*.mjs",
    "tools/*.mjs",
    "tests/**/*.mjs"
  ],
  "project": [
    "app/**/*.js",
    "lib/**/*.mjs",
    "scripts/*.mjs",
    "tools/*.mjs",
    "tests/**/*.mjs"
  ],
  "ignoreDependencies": [
    "leaflet",
    "xlsx"
  ],
  "ignoreBinaries": [
    "pdftotext",
    "openssl"
  ],
  "ignoreUnresolved": [
    "^\\.?/app/"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "warn"
  }
}
